# Database
CREATIENDAS_FINAL_DB=postgresql://user:password@localhost:5432/creatiendas?schema=public

# NextAuth - CRITICAL: Change these in production!
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme1234567890abcdef

# Encryption Key - CRITICAL: Generate a secure key for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Stripe (opcional)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Security Settings (optional)
# Rate limiting is enabled by default
# Adjust in lib/rate-limit.ts if needed

# Alert System
RESEND_API_KEY=re_123456789
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_WHATSAPP=573001234567
# Mailtrap SMTP (example for local development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM="Creatiendas <no-reply@creatiendas.com>"
