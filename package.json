    "@vercel/blob": "^0.22.1",
    "@vercel/kv": "^1.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.344.0",
    "next": "14.2.3",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.7",
    "pg": "^8.11.3",
    "postcss-preset-env": "^9.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^3.2.0",
