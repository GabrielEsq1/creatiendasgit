generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CREATIENDAS_FINAL_DB")
}

// Role enum for user permissions
enum Role {
  USER
  ADMIN
  ADMIN_EMPRESA
  SUPERADMIN
  USUARIO
}

// Unified User model for B2BChat + Creatiendas + Monedera
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  phone             String?  @unique
  passwordHash      String   @default("")
  emailVerified     DateTime?
  verificationToken String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  role              Role     @default(USER)
  plan              String   @default("FREE") // "FREE" or "PRO"

  // Profile data
  position          String?
  bio               String?
  website           String?
  industry          String?
  profilePicture    String?
  avatar            String?

  // Reset password
  resetCode         String?
  resetCodeExpiresAt DateTime?

  // Company relation
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id])

  // Creatiendas relations
  stores            Store[]
  stripeCustomer    StripeCustomer?
  passwordResetTokens PasswordResetToken[]
  
  // Monedera relations
  walletAccount     WalletAccount?
  
  // B2BChat relations (Advanced)
  conversationsAsA  Conversation[]   @relation("UserA")
  conversationsAsB  Conversation[]   @relation("UserB")
  
  // Legacy B2B relations (referenced in some files)
  conversations     Conversation[]
  sentMessages      Message[]        @relation("SentMessages")
  contacts          Contact[]        @relation("UserContacts")
  contactOf         Contact[]        @relation("ContactUser")
  
  // Advertising relations
  campaigns         AdCampaign[]
  
  // Social relations
  groupMembers      GroupMember[]
  createdGroups     Group[]          @relation("GroupCreator")
  
  // NextAuth
  accounts          Account[]
  sessions          Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                String   @id @default(cuid())
  name              String
  taxId             String?  @unique
  description       String?
  website           String?
  industry          String?
  logo              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  campaigns         AdCampaign[]
  
  connectionsA      CompanyConnection[] @relation("CompanyA")
  connectionsB      CompanyConnection[] @relation("CompanyB")
}

model CompanyConnection {
  id                String   @id @default(cuid())
  companyAId        String
  companyBId        String
  status            String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companyA          Company  @relation("CompanyA", fields: [companyAId], references: [id])
  companyB          Company  @relation("CompanyB", fields: [companyBId], references: [id])

  @@unique([companyAId, companyBId])
}

// ============================================
// CREATIENDAS MODELS
// ============================================

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  views     Int      @default(0)
  data      Json?
  products  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  images    StoredImage[]
}

model StoredImage {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      String   // "logo", "hero", "product", "gallery"
  mimeType  String   // "image/jpeg", etc.
  content   String   @db.Text // The Base64 content
  createdAt DateTime @default(now())
}

// ============================================
// ADVERTISING MODELS
// ============================================

model AdCampaign {
  id            String       @id @default(cuid())
  name          String
  objective     String       // e.g., "SALES", "AWARENESS"
  status        String       @default("DRAFT") // DRAFT, PENDING, ACTIVE, PAUSED, COMPLETED
  industry      String?
  sector        String?
  targetRoles   String?      // JSON string of roles
  dailyBudget   Float        @default(0)
  durationDays  Int          @default(0)
  totalBudget   Float        @default(0)
  spent         Float        @default(0)
  impressions   Int          @default(0)
  clicks        Int          @default(0)
  conversions   Int          @default(0)
  creativeType  String       // IMAGE, VIDEO
  creativeUrl   String?
  creativeText  String?
  videoUrl      String?      // Added
  videoDuration Int?         // Added
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  userId        String
  user          User         @relation(fields: [userId], references: [id])
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  
  creatives     AdCreative[]
}

model AdCreative {
  id             String      @id @default(cuid())
  campaignId     String
  campaign       AdCampaign  @relation(fields: [campaignId], references: [id])
  title          String
  description    String?
  imageUrl       String?
  videoUrl       String?
  videoDuration  Int?
  ctaLabel       String      @default("Ver Más")
  destinationUrl String
  ageRange       String?
  gender         String      @default("ALL")
  location       String?
  type           String      // IMAGE, VIDEO
  isActive       Boolean     @default(true)
  approvalStatus String      @default("PENDING") // PENDING, APPROVED, REJECTED
  displayOrder   Int         @default(0)
  rotationHours  Int         @default(1)
  lastShownAt    DateTime?
  
  // Basic metrics
  impressions    Int         @default(0)
  clicks         Int         @default(0)
  
  // Detailed stats relation
  stats          AdCreativeStats?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model AdCreativeStats {
  id            String     @id @default(cuid())
  creativeId    String     @unique
  creative      AdCreative @relation(fields: [creativeId], references: [id])
  
  impressions   Int        @default(0)
  clicks        Int        @default(0)
  ctr           Float      @default(0)
  conversions   Int        @default(0)
  revenue       Float      @default(0)
  
  lastUpdated   DateTime   @default(now())
}

// ============================================
// MONEDERA (WALLET) MODELS
// ============================================

model StripeCustomer {
  id               String   @id @default(cuid())
  stripeCustomerId String   @unique
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WalletAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("COP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transactions Transaction[]
}

model Transaction {
  id          String        @id @default(cuid())
  accountId   String
  account     WalletAccount @relation(fields: [accountId], references: [id])
  type        String        // "credit" or "debit"
  amount      Decimal       @db.Decimal(12, 2)
  description String
  metadata    Json?         // Store recipient, sender, method, etc.
  status      String        @default("completed") // "pending", "completed", "failed"
  createdAt   DateTime      @default(now())
  
  @@index([accountId])
  @@index([createdAt])
}

// ============================================
// B2BCHAT & SOCIAL MODELS
// ============================================

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  createdById String
  createdBy   User          @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     GroupMember[]
  conversations Conversation[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  isAdmin   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Conversation {
  id            String    @id @default(cuid())
  type          String    @default("USER_USER") // USER_USER, GROUP
  title         String?
  
  // Dual-user relation
  userAId       String?
  userA         User?     @relation("UserA", fields: [userAId], references: [id])
  userBId       String?
  userB         User?     @relation("UserB", fields: [userBId], references: [id])
  
  // Group relation
  groupId       String?
  group         Group?    @relation(fields: [groupId], references: [id])
  
  // Legacy single-user relation
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  messages      Message[]
  participants  ConversationParticipant[]
  
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  
  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // Sender fields
  senderId       String?
  sender         User?        @relation("SentMessages", fields: [senderId], references: [id])
  senderUserId   String?      // Used in many routes/scripts

  content        String?      @db.Text
  text           String?      @db.Text
  attachmentUrl  String?      // Missing field
  
  type           String       @default("text") // "text", "image", "file", "payment"
  metadata       Json?        // For attachments, payment info, etc.
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  
  @@index([conversationId])
  @@index([createdAt])
}

model Contact {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserContacts", fields: [userId], references: [id])
  contactId   String
  contact     User     @relation("ContactUser", fields: [contactId], references: [id])
  name        String?  // Optional custom name for the contact
  email       String?
  phone       String?
  company     String?
  tags        String[] // For segmentation
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
}

// ============================================
// ANALYTICS MODELS
// ============================================

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String   // "page_view", "click", "signup", "create_store"
  eventName String?  // Optional specific name
  userId    String?  // Optional, if user is logged in
  path      String?  // URL path
  metadata  Json?    // Any extra data
  ipAddress String?  // Anonymized IP
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

