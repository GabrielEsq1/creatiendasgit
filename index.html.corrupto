<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Builder MVP - Shark Tank Edition</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Iconos para UI del Builder -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        /* =========================================
           ESTILOS BASE Y VARIABLES
           ========================================= */
        :root {
            --primary-color: #0f172a;
            --accent-color: #2563eb;
            /* Azul más corporativo para el builder */
            --success-color: #25D366;
            --text-main: #1e293b;
            --text-light: #64748b;
            --bg-body: #f1f5f9;
            --border-color: #e2e8f0;
            --radius-sm: 6px;
            --radius-md: 12px;
            --font-main: 'Inter', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-main);
            background-color: var(--bg-body);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Layout Principal */
        .app-container {
            display: flex;
            height: 100vh;
            width: 100%;
            overflow: hidden;
        }

        /* =========================================
           PANEL IZQUIERDO: BUILDER
           ========================================= */
        .builder-panel {
            width: 380px;
            height: 100%;
            background: #fff;
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            z-index: 10;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.02);
        }

        .builder-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            flex-shrink: 0;
        }

        .builder-brand h2 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .builder-brand span {
            font-size: 0.7rem;
            background: var(--accent-color);
            color: white;
            padding: 0.1rem 0.4rem;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .action-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-light);
            font-size: 1rem;
            padding: 0.4rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: #f1f5f9;
            color: var(--accent-color);
        }

        .builder-content {
            flex: 1;
            overflow-y: auto;
            padding: 0;
            min-height: 0;
            /* Crucial para el scroll en flex items */
        }

        summary.section-summary {
            padding: 1rem 1.25rem;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text-main);
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8fafc;
            user-select: none;
            border-bottom: 1px solid var(--border-color);
        }

        summary.section-summary:hover {
            background: #f1f5f9;
        }

        summary.section-summary::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: 0.8rem;
            transition: transform 0.2s;
            color: var(--text-light);
        }

        details[open] summary.section-summary::after {
            transform: rotate(180deg);
        }

        .section-content {
            padding: 1.25rem;
            border-bottom: 1px solid var(--border-color);
            background: #fff;
        }

        /* Formularios */
        .form-group {
            margin-bottom: 1rem;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.4rem;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-main);
        }

        .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        /* Color Picker */
        .color-input-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid var(--border-color);
            padding: 0.4rem;
            border-radius: var(--radius-sm);
        }

        .color-input-group input[type="color"] {
            border: none;
            width: 32px;
            height: 32px;
            cursor: pointer;
            background: none;
        }

        .color-input-group span {
            font-size: 0.9rem;
            color: var(--text-light);
            font-family: monospace;
        }

        /* Botones */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 1.5rem;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            gap: 0.5rem;
            width: 100%;
        }

        .btn-primary {
            background-color: var(--accent-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
        }

        .btn-secondary {
            background-color: #f1f5f9;
            color: var(--text-main);
        }

        .btn-secondary:hover {
            background-color: #e2e8f0;
        }

        .btn-success {
            background-color: var(--success-color);
            color: white;
        }

        .btn-success:hover {
            filter: brightness(95%);
        }

        .btn-danger {
            background-color: #ef4444;
            color: white;
        }

        .btn-danger:hover {
            background-color: #dc2626;
        }

        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
            width: auto;
        }

        /* Lista de productos mini */
        .mini-product-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 1rem;
            max-height: 300px;
            overflow-y: auto;
        }

        .mini-product-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem;
            background: #f8fafc;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            transition: border-color 0.2s;
            cursor: pointer;
        }

        .mini-product-item:hover {
            border-color: var(--accent-color);
        }

        .mini-product-item.editing {
            border-color: var(--accent-color);
            background: #eff6ff;
        }

        .mini-product-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .mini-product-thumb {
            width: 36px;
            height: 36px;
            border-radius: 4px;
            object-fit: cover;
            background: #ddd;
        }

        .mini-product-text h4 {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0;
        }

        .mini-product-text p {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .builder-footer {
            padding: 1.5rem;
            border-top: 1px solid var(--border-color);
            background: #fff;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        /* =========================================
           PANEL DERECHO: PREVIEW
           ========================================= */
        .preview-panel {
            flex: 1;
            background-color: #e2e8f0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        .preview-toolbar {
            height: 50px;
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 0 1rem;
            flex-shrink: 0;
        }

        .device-toggle {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 4px;
            color: var(--text-light);
            transition: all 0.2s;
        }

        .device-toggle:hover,
        .device-toggle.active {
            background: #f1f5f9;
            color: var(--accent-color);
        }

        .device-toggle i {
            font-size: 1.1rem;
        }

        .preview-viewport {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .store-frame {
            background: white;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            transition: width 0.3s ease;
            min-height: 100%;
            width: 100%;
            /* Default Desktop */
        }

        .store-frame.mobile {
            width: 375px;
            min-height: 667px;
            border-radius: 20px;
            border: 8px solid #1e293b;
            overflow: hidden;
            /* Para que el contenido no se salga del borde redondeado */
        }

        /* --- ESTILOS DE LA TIENDA GENERADA (Se exportarán) --- */
        /* Copia exacta de los estilos "Pro" anteriores, más ajustes */

        .s-navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 5%;
            background: white;
            border-bottom: 1px solid #eee;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .s-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 700;
            font-size: 1.25rem;
            color: #1e293b;
            text-decoration: none;
        }

        .s-logo {
            height: 40px;
            width: auto;
        }

        .s-nav-links {
            display: flex;
            gap: 1.5rem;
        }

        .s-nav-link {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        .s-nav-link:hover {
            color: var(--primary-color);
        }

        .s-hero {
            position: relative;
            padding: 5rem 5%;
            background-color: var(--primary-color);
            color: white;
            text-align: center;
            overflow: hidden;
            min-height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .s-hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.3;
            z-index: 0;
        }

        .s-hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
        }

        .s-hero-title {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 1rem;
            line-height: 1.1;
        }

        .s-hero-subtitle {
            font-size: 1.25rem;
            opacity: 0.9;
            margin-bottom: 2rem;
            font-weight: 300;
        }

        .s-btn-cta {
            display: inline-block;
            background: white;
            color: var(--primary-color);
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .s-btn-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        .s-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 1.5rem;
        }

        .s-section-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .s-section-title {
            font-size: 2rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .s-section-desc {
            color: #64748b;
        }

        .s-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
        }

        .s-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #f1f5f9;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .s-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .s-card-img-container {
            width: 100%;
            padding-top: 100%;
            position: relative;
            background: #f8fafc;
        }

        .s-card-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .s-card-body {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .s-card-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #94a3b8;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .s-card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }

        .s-card-desc {
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 1rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .s-card-price {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--primary-color);
            margin-top: auto;
            margin-bottom: 1rem;
        }

        .s-btn-buy {
            width: 100%;
            padding: 0.8rem;
            background-color: #25D366;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
            transition: background 0.2s;
        }

        .s-btn-buy:hover {
            background-color: #128C7E;
        }

        .s-footer {
            background: #1e293b;
            color: white;
            padding: 4rem 1.5rem;
            margin-top: auto;
        }

        .s-footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 3rem;
        }

        .s-footer-col h4 {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        .s-footer-col p {
            color: #94a3b8;
            line-height: 1.6;
            font-size: 0.9rem;
        }

        .s-footer-links {
            list-style: none;
        }

        .s-footer-links li {
            margin-bottom: 0.8rem;
        }

        .s-footer-links a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s;
        }

        .s-footer-links a:hover {
            color: white;
        }

        .s-social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .s-social-links a {
            color: white;
            font-size: 1.2rem;
            opacity: 0.8;
            transition: opacity 0.2s;
        }

        .s-social-links a:hover {
            opacity: 1;
        }

        .s-copyright {
            text-align: center;
            border-top: 1px solid #334155;
            margin-top: 3rem;
            padding-top: 2rem;
            color: #64748b;
            font-size: 0.85rem;
        }

        /* ESTILOS CATEGORY BAR */
        .s-category-bar-container {
            background: white;
            border-bottom: 1px solid #e2e8f0;
            padding: 1.5rem 0;
        }

        .s-category-bar {
            display: flex;
            overflow-x: auto;
            gap: 2rem;
            padding: 0 5%;
            scrollbar-width: none;
            -ms-overflow-style: none;
            justify-content: center;
        }

        .s-category-bar::-webkit-scrollbar {
            display: none;
        }

        .s-cat-item {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            text-decoration: none;
            color: #64748b;
            transition: transform 0.2s;
            min-width: 80px;
        }

        .s-cat-item:hover {
            transform: translateY(-3px);
            color: var(--primary-color);
        }

        .s-cat-icon {
            width: 60px;
            height: 60px;
            background: #f1f5f9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.5rem;
            font-size: 1.5rem;
            color: var(--primary-color);
            border: 2px solid transparent;
            transition: border-color 0.2s;
            overflow: hidden;
        }

        .s-cat-item:hover .s-cat-icon {
            border-color: var(--primary-color);
        }

        .s-cat-name {
            font-size: 0.85rem;
            font-weight: 600;
            text-align: center;
        }


        @media (max-width: 900px) {
            .app-container {
                flex-direction: column;
                overflow: auto;
            }

            .builder-panel {
                width: 100%;
                height: auto;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .s-hero-title {
                font-size: 2rem;
            }

            .s-nav-links {
                display: none;
            }

            .s-category-bar {
                justify-content: flex-start;
            }
        }

        /* MODAL (Preview) */
        .s-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .s-modal-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
        }

        .s-modal-content {
            position: relative;
            background: white;
            width: 90%;
            max-width: 900px;
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 90vh;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .s-modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: white;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            z-index: 10;
            transition: transform 0.2s;
        }

        .s-modal-close:hover {
            transform: rotate(90deg);
        }

        .s-modal-body {
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .s-modal-img-col {
            width: 100%;
            background: #f8fafc;
            min-height: 300px;
            position: relative;
        }

        .s-modal-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .s-modal-info-col {
            padding: 2rem;
            display: flex;
            flex-direction: column;
        }

        .s-modal-title {
            font-size: 1.75rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            line-height: 1.2;
        }

        .s-modal-price {
            font-size: 1.5rem;
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        .s-modal-desc {
            color: #64748b;
            line-height: 1.7;
            margin-bottom: 2rem;
            flex: 1;
            font-size: 1rem;
        }

        .s-btn-block {
            width: 100%;
            justify-content: center;
            padding: 1rem;
            font-size: 1.1rem;
        }

        @media (min-width: 768px) {
            .s-modal-body {
                flex-direction: row;
                height: auto;
            }

            .s-modal-img-col {
                width: 50%;
                min-height: 500px;
            }

            .s-modal-info-col {
                width: 50%;
                padding: 3rem;
            }
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- PANEL CONSTRUCTOR -->
        <aside class="builder-panel">
            <div class="builder-header">
                <div class="builder-brand">
                    <h2>🛍️ Store Builder <span>MVP</span></h2>
                </div>
                <div class="builder-actions">
                    <button class="action-btn" id="btnReset" title="Resetear todo"><i
                            class="fa-solid fa-rotate-right"></i></button>
                </div>
            </div>

            <div class="builder-content">

                <!-- 1. Identidad -->
                <details class="form-section" open>
                    <summary class="section-summary">Identidad & Marca</summary>
                    <div class="section-content">
                        <div class="form-group">
                            <label>Nombre de la Marca</label>
                            <input type="text" id="storeName" class="form-control" placeholder="Ej: MADOCO">
                        </div>
                        <div class="form-group">
                            <label>Logo (PNG/JPG)</label>
                            <input type="file" id="storeLogo" class="form-control" accept="image/*">
                        </div>
                        <div class="form-group">
                            <label>Color de Marca</label>
                            <div class="color-input-group">
                                <input type="color" id="storeColor" value="#0f172a">
                                <span id="colorValue">#0f172a</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>WhatsApp de Ventas</label>
                            <input type="tel" id="whatsappNumber" class="form-control" placeholder="Ej: 573001234567">
                        </div>
                    </div>
                </details>

                <!-- 2. Portada -->
                <details class="form-section">
                    <summary class="section-summary">Portada (Hero)</summary>
                    <div class="section-content">
                        <div class="form-group">
                            <label>Título Principal</label>
                            <input type="text" id="heroTitle" class="form-control"
                                placeholder="Ej: Prendas para salvar vidas">
                        </div>
                        <div class="form-group">
                            <label>Subtítulo</label>
                            <textarea id="heroSubtitle" class="form-control" rows="2"
                                placeholder="Ej: Calidad y protección certificada..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Imagen de Fondo</label>
                            <input type="file" id="heroImage" class="form-control" accept="image/*">
                        </div>
                    </div>
                </details>

                <!-- 3. Productos -->
                <details class="form-section" open>
                    <summary class="section-summary">Catálogo de Productos</summary>
                    <div class="section-content">
                        <input type="hidden" id="prodId"> <!-- Para edición -->

                        <div class="form-group">
                            <label>Nombre Producto</label>
                            <input type="text" id="prodName" class="form-control">
                        </div>
                        <div class="form-group">
                            <label>Descripción</label>
                            <textarea id="prodDesc" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="form-group" style="display:flex; gap:1rem;">
                            <div style="flex:1">
                                <label>Precio</label>
                                <input type="number" id="prodPrice" class="form-control" placeholder="0">
                            </div>
                            <div style="flex:1">
                                <label>Categoría</label>
                                <input type="text" id="prodCat" class="form-control" placeholder="Ej: Camisas">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Foto Producto</label>
                            <input type="file" id="prodImage" class="form-control" accept="image/*">
                        </div>

                        <div style="display:flex; gap:0.5rem;">
                            <button class="btn btn-secondary" id="btnAddProduct">
                                <span>+</span> Agregar
                            </button>
                            <button class="btn btn-primary" id="btnUpdateProduct" style="display:none;">
                                <span>✓</span> Actualizar
                            </button>
                            <button class="btn btn-danger" id="btnCancelEdit" style="display:none; width:auto;">
                                ✕
                            </button>
                        </div>

                        <div id="productList" class="mini-product-list"></div>
                    </div>
                </details>

                <!-- 4. Redes & SEO -->
                <details class="form-section">
                    <summary class="section-summary">Redes & SEO</summary>
                    <div class="section-content">
                        <div class="form-group">
                            <label>Instagram URL</label>
                            <input type="url" id="socialInsta" class="form-control"
                                placeholder="https://instagram.com/...">
                        </div>
                        <div class="form-group">
                            <label>Facebook URL</label>
                            <input type="url" id="socialFb" class="form-control" placeholder="https://facebook.com/...">
                        </div>
                        <div class="form-group">
                            <label>Email de Contacto</label>
                            <input type="email" id="contactEmail" class="form-control">
                        </div>
                    </div>
                </details>

            </div>

            <div class="builder-footer">
                <button class="btn btn-primary" id="btnUpdate">
                    🔄 Actualizar Vista Previa
                </button>
                <button class="btn btn-success" id="btnExport">
                    💾 Descargar Tienda (.html)
                </button>
            </div>
        </aside>

        <!-- PANEL PREVIEW -->
        <main class="preview-panel">
            <div class="preview-toolbar">
                <button class="device-toggle active" data-mode="desktop" title="Vista Escritorio">
                    <i class="fa-solid fa-desktop"></i>
                </button>
                <button class="device-toggle" data-mode="mobile" title="Vista Móvil">
                    <i class="fa-solid fa-mobile-screen"></i>
                </button>
            </div>
            <div class="preview-viewport">
                <div id="storeFrame" class="store-frame">
                    <!-- Contenido renderizado dinámicamente -->
                    els.color.value = state.meta.color || '#0f172a';
                    els.colorVal.textContent = els.color.value;
                    els.whatsapp.value = state.meta.whatsapp || '';
                    els.heroTitle.value = state.meta.heroTitle || '';
                    els.heroSubtitle.value = state.meta.heroSubtitle || '';
                    els.socialInsta.value = state.meta.socialInsta || '';
                    els.socialFb.value = state.meta.socialFb || '';
                    els.contactEmail.value = state.meta.contactEmail || '';
                    }

                    function updateMetaFromForm() {
                    state.meta.name = els.name.value.trim();
                    state.meta.color = els.color.value;
                    state.meta.whatsapp = els.whatsapp.value.replace(/\D/g, '');
                    state.meta.heroTitle = els.heroTitle.value.trim();
                    state.meta.heroSubtitle = els.heroSubtitle.value.trim();
                    state.meta.socialInsta = els.socialInsta.value.trim();
                    state.meta.socialFb = els.socialFb.value.trim();
                    state.meta.contactEmail = els.contactEmail.value.trim();
                    saveState();
                    }

                    // --- LISTENERS ---
                    els.color.addEventListener('input', (e) => {
                    els.colorVal.textContent = e.target.value;
                    updateMetaFromForm(); // Auto-save on color change
                    });

                    els.logo.addEventListener('change', async (e) => {
                    if (e.target.files[0]) {
                    state.meta.logo = await fileToBase64(e.target.files[0]);
                    saveState();
                    renderStore();
                    }
                    });

                    els.heroImage.addEventListener('change', async (e) => {
                    if (e.target.files[0]) {
                    state.meta.heroImage = await fileToBase64(e.target.files[0]);
                    saveState();
                    renderStore();
                    }
                    });

                    // Product Management
                    els.btnAdd.addEventListener('click', async () => {
                    const name = els.pName.value.trim();
                    const price = els.pPrice.value.trim();
                    if (!name || !price) return alert('Nombre y precio requeridos');

                    let img = null;
                    if (els.pImage.files[0]) img = await fileToBase64(els.pImage.files[0]);

                    state.products.push({
                    id: Date.now(),
                    name,
                    price,
                    category: els.pCat.value.trim() || 'General',
                    description: els.pDesc.value.trim(), // Nuevo
                    image: img
                    });

                    saveState();
                    renderMiniList();
                    resetProductForm();
                    renderStore(); // Auto-update preview
                    });

                    els.btnUpdateProd.addEventListener('click', async () => {
                    if (!editingId) return;

                    const product = state.products.find(p => p.id === editingId);
                    if (!product) return;

                    product.name = els.pName.value.trim();
                    product.price = els.pPrice.value.trim();
                    product.category = els.pCat.value.trim() || 'General';
                    product.description = els.pDesc.value.trim(); // Nuevo

                    if (els.pImage.files[0]) {
                    product.image = await fileToBase64(els.pImage.files[0]);
                    }

                    saveState();
                    renderMiniList();
                    resetProductForm();
                    renderStore();
                    });

                    els.btnCancelEdit.addEventListener('click', resetProductForm);

                    // Global Actions
                    els.btnUpdate.addEventListener('click', () => {
                    updateMetaFromForm();
                    renderStore();
                    });

                    els.btnExport.addEventListener('click', () => {
                    updateMetaFromForm();
                    exportStore();
                    });

                    els.btnReset.addEventListener('click', () => {
                    if (confirm('¿Estás seguro de borrar todo?')) {
                    state = JSON.parse(JSON.stringify(defaultState));
                    saveState();
                    location.reload();
                    }
                    });

                    // Device Toggle
                    els.toggles.forEach(btn => {
                    btn.addEventListener('click', () => {
                    els.toggles.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const mode = btn.dataset.mode;
                    if (mode === 'mobile') els.frame.classList.add('mobile');
                    else els.frame.classList.remove('mobile');
                    });
                    });

                    // --- HELPERS ---
                    function fileToBase64(file) {
                    return new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.readAsDataURL(file);
                    });
                    }

                    function resetProductForm() {
                    editingId = null;
                    els.pName.value = '';
                    els.pPrice.value = '';
                    els.pCat.value = '';
                    els.pDesc.value = ''; // Reset desc
                    els.pImage.value = '';
                    els.btnAdd.style.display = 'inline-flex';
                    els.btnUpdateProd.style.display = 'none';
                    els.btnCancelEdit.style.display = 'none';

                    // Remove highlight
                    document.querySelectorAll('.mini-product-item').forEach(el => el.classList.remove('editing'));
                    }

                    function editProduct(id) {
                    const product = state.products.find(p => p.id === id);
                    if (!product) return;

                    editingId = id;
                    els.pName.value = product.name;
                    els.pPrice.value = product.price;
                    els.pCat.value = product.category;
                    els.pDesc.value = product.description || ''; // Load desc

                    els.btnAdd.style.display = 'none';
                    els.btnUpdateProd.style.display = 'inline-flex';
                    els.btnCancelEdit.style.display = 'inline-flex';

                    // Highlight list item
                    renderMiniList();
                    }

                    window.deleteProduct = (e, id) => {
                    e.stopPropagation();
                    if (confirm('¿Eliminar producto?')) {
                    state.products = state.products.filter(p => p.id !== id);
                    if (editingId === id) resetProductForm();
                    saveState();
                    renderMiniList();
                    renderStore();
                    }
                    };

                    function renderMiniList() {
                    els.pList.innerHTML = state.products.map(p => `
                    <div class="mini-product-item ${p.id === editingId ? 'editing' : ''}"
                        onclick="editProduct(${p.id})">
                        <div class="mini-product-info">
                            <div class="mini-product-thumb"
                                style="${p.image ? `background-image:url(${p.image});background-size:cover` : ''}">
                            </div>
                            <div class="mini-product-text">
                                <h4>${p.name}</h4>
                                <p>$${p.price}</p>
                            </div>
                        </div>
                        <button onclick="deleteProduct(event, ${p.id})" class="btn-sm"
                            style="background:none;border:none;cursor:pointer;color:#ef4444;padding:0.5rem;">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                    `).join('');
                    }

                    // --- RENDER & EXPORT ---
                    function generateWhatsAppLink(product) {
                    const phone = state.meta.whatsapp;
                    if (!phone) return '#';
                    const text = `Hola, me interesa: ${product.name} ($${product.price}).`;
                    return `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
                    }

                    function getStoreHTML() {
                    const { name, color, logo, heroTitle, heroSubtitle, heroImage, socialInsta, socialFb, contactEmail }
                    = state.meta;

                    // 1. Agrupar categorías y obtener imagen representativa
                    const categories = {};
                    state.products.forEach(p => {
                    const cat = p.category || 'General';
                    if (!categories[cat]) {
                    categories[cat] = { name: cat, image: p.image };
                    }
                    });

                    // 2. Generar HTML de barra de categorías (Incluyendo "Todo")
                    const allCats = [{ name: 'Todo', image: null }, ...Object.values(categories)];

                    const categoriesHTML = allCats.map((c, index) => `
                    <div class="s-cat-item ${index === 0 ? 'active' : ''}" onclick="filterProducts(this, '${c.name}')">
                        <div class="s-cat-icon"
                            style="${c.image ? `background-image:url(${c.image});background-size:cover;` : ''}">
                            ${!c.image ? '<i class="fa-solid fa-border-all"></i>' : ''}
                        </div>
                        <span class="s-cat-name">${c.name}</span>
                    </div>
                    `).join('');

                    const productsHTML = state.products.map(p => `
                    <article class="s-card" data-category="${p.category || 'General'}"
                        onclick="openProductModal(${p.id})">
                        <div class="s-card-img-container">
                            ${p.image ? `<img src="${p.image}" class="s-card-img" alt="${p.name}">` : ''}
                        </div>
                        <div class="s-card-body">
                            <div class="s-card-category">${p.category || 'General'}</div>
                            <h3 class="s-card-title">${p.name}</h3>
                            ${p.description ? `<p class="s-card-desc">${p.description}</p>` : ''}
                            <div class="s-card-price">$${Number(p.price).toLocaleString()}</div>
                            <button class="s-btn-buy">
                                <i class="fa-brands fa-whatsapp"></i> Ver
                            </button>
                        </div>
                    </article>
                    `).join('');

                    const modalHTML = `
                    <div id="s-product-modal" class="s-modal" style="display: none;">
                        <div class="s-modal-overlay" onclick="closeModal()"></div>
                        <div class="s-modal-content">
                            <button class="s-modal-close" onclick="closeModal()">&times;</button>
                            <div class="s-modal-body">
                                <div class="s-modal-img-col">
                                    <img id="m-img" src="" alt="" class="s-modal-img">
                                </div>
                                <div class="s-modal-info-col">
                                    <h2 id="m-title" class="s-modal-title"></h2>
                                    <div id="m-price" class="s-modal-price"></div>
                                    <p id="m-desc" class="s-modal-desc"></p>
                                    <div class="s-modal-actions">
                                        <a id="m-btn" href="#" target="_blank" class="s-btn-buy s-btn-block">
                                            <i class="fa-brands fa-whatsapp"></i> Pedir por WhatsApp
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    `;

                    const scriptHTML = `
                    <script>
                        const productsData = ${ JSON.stringify(state.products)};

                        function filterProducts(element, category) {
                            document.querySelectorAll('.s-cat-item').forEach(el => el.classList.remove('active'));
                            element.classList.add('active');
                            const cards = document.querySelectorAll('.s-card');
                            cards.forEach(card => {
                                if (category === 'Todo' || card.dataset.category === category) {
                                    card.style.display = 'flex';
                                } else {
                                    card.style.display = 'none';
                                }
                            });
                        }

                        function openProductModal(id) {
                            const p = productsData.find(x => x.id == id);
                            if (!p) return;

                            const imgEl = document.getElementById('m-img');
                            if (p.image) {
                                imgEl.src = p.image;
                                imgEl.style.display = 'block';
                            } else {
                                imgEl.style.display = 'none';
                            }

                            document.getElementById('m-title').innerText = p.name;
                            document.getElementById('m-price').innerText = '$' + Number(p.price).toLocaleString();
                            document.getElementById('m-desc').innerText = p.description || '';

                            const phone = '${state.meta.whatsapp || ''}';
                            const text = encodeURIComponent(\`Hola, me interesa: \${p.name}\`);
                    document.getElementById('m-btn').href = \`https://wa.me/\${phone}?text=\${text}\`;

                    document.getElementById('s-product-modal').style.display = 'flex';
                }

                function closeModal() {
                    document.getElementById('s-product-modal').style.display = 'none';
                }
            <\/script>
            `;

                            return `
            <!-- NAVBAR -->
            <nav class="s-navbar">
                <a href="#" class="s-brand">
                    ${logo ? `<img src="${logo}" class="s-logo">` : ''}
                    <span>${name}</span>
                </a>
                <div class="s-nav-links">
                    <a href="#" class="s-nav-link">Inicio</a>
                    <a href="#catalogo" class="s-nav-link">Catálogo</a>
                    <a href="#contacto" class="s-nav-link">Contacto</a>
                </div>
            </nav>

            <!-- HERO -->
            <header class="s-hero">
                ${heroImage ? `<img src="${heroImage}" class="s-hero-bg">` : ''}
                <div class="s-hero-content">
                    <h1 class="s-hero-title">${heroTitle}</h1>
                    <p class="s-hero-subtitle">${heroSubtitle}</p>
                    <a href="#catalogo" class="s-btn-cta">Ver Colección</a>
                </div>
            </header>

            <!-- CATEGORY BAR -->
            <div class="s-category-bar-container">
                <div class="s-category-bar">
                    ${categoriesHTML}
                </div>
            </div>

            <!-- CATALOGO -->
            <section id="catalogo" class="s-container">
                <div class="s-section-header">
                    <h2 class="s-section-title">Nuestros Productos</h2>
                    <p class="s-section-desc">Calidad y diseño en cada detalle</p>
                </div>
                <div class="s-grid">
                    ${productsHTML}
                </div>
            </section>

            <!-- FOOTER -->
            <footer class="s-footer" id="contacto">
                <div class="s-footer-content">
                    <div class="s-footer-col">
                        <h4>${name}</h4>
                        <p>Comprometidos con la calidad y el servicio.</p>
                        <div class="s-social-links">
                            ${socialInsta ? `<a href="${socialInsta}" target="_blank"><i class="fa-brands fa-instagram"></i></a>` : ''}
                            ${socialFb ? `<a href="${socialFb}" target="_blank"><i class="fa-brands fa-facebook"></i></a>` : ''}
                        </div>
                    </div>
                    <div class="s-footer-col">
                        <h4>Enlaces</h4>
                        <ul class="s-footer-links">
                            <li><a href="#">Inicio</a></li>
                            <li><a href="#">Catálogo</a></li>
                        </ul>
                    </div>
                    <div class="s-footer-col">
                        <h4>Contacto</h4>
                        <ul class="s-footer-links">
                            <li><i class="fa-brands fa-whatsapp"></i> ${state.meta.whatsapp || 'No configurado'}</li>
                            ${contactEmail ? `<li><i class="fa-regular fa-envelope"></i> ${contactEmail}</li>` : ''}
                        </ul>
                    </div>
                </div>
                <div class="s-copyright">
                    &copy; ${new Date().getFullYear()} ${name}. Todos los derechos reservados.
                </div>
            </footer>
            ${modalHTML}
            ${scriptHTML}
        `;
                        }

                        // --- LIVE PREVIEW HELPERS ---
                        window.filterProducts = (element, category) => {
                            const container = document.getElementById('storeFrame');
                            if (!container) return;
                            container.querySelectorAll('.s-cat-item').forEach(el => el.classList.remove('active'));
                            element.classList.add('active');
                            const cards = container.querySelectorAll('.s-card');
                            cards.forEach(card => {
                                if (category === 'Todo' || card.dataset.category === category) {
                                    card.style.display = 'flex';
                                } else {
                                    card.style.display = 'none';
                                }
                            });
                        };

                        window.openProductModal = (id) => {
                            const p = state.products.find(x => x.id == id);
                            if (!p) return;

                            const modal = document.getElementById('s-product-modal');
                            if (!modal) return;

                            const imgEl = document.getElementById('m-img');
                            if (p.image) {
                                imgEl.src = p.image;
                                imgEl.style.display = 'block';
                            } else {
                                imgEl.style.display = 'none';
                            }

                            document.getElementById('m-title').innerText = p.name;
                            document.getElementById('m-price').innerText = '$' + Number(p.price).toLocaleString();
                            document.getElementById('m-desc').innerText = p.description || '';

                            const phone = state.meta.whatsapp || '';
                            const text = encodeURIComponent(`Hola, me interesa: ${p.name}`);
                            document.getElementById('m-btn').href = `https://wa.me/${phone}?text=${text}`;

                            modal.style.display = 'flex';
                        };

                        window.closeModal = () => {
                            const modal = document.getElementById('s-product-modal');
                            if (modal) modal.style.display = 'none';
                        };

                        function renderStore() {
                            const styleId = 'dynamic-store-style';
                            let styleEl = document.getElementById(styleId);
                            if (!styleEl) {
                                styleEl = document.createElement('style');
                                styleEl.id = styleId;
                                document.head.appendChild(styleEl);
                            }
                            styleEl.innerHTML = `:root { --primary-color: ${state.meta.color}; }`;
                            els.frame.innerHTML = getStoreHTML();
                        }

                        function exportStore() {
                            const htmlContent = getStoreHTML();
                            const { name, color } = state.meta;

                            const fullHTML = `<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${name}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: ${color};
            --font-main: 'Inter', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: var(--font-main); background: #f8fafc; color: #1e293b; }
        
        /* ESTILOS DE LA TIENDA */
        .s-navbar { display: flex; align-items: center; justify-content: space-between; padding: 1rem 5%; background: white; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 100; }
        .s-brand { display: flex; align-items: center; gap: 0.75rem; font-weight: 700; font-size: 1.25rem; color: #1e293b; text-decoration: none; }
        .s-logo { height: 40px; width: auto; }
        .s-nav-links { display: flex; gap: 1.5rem; }
        .s-nav-link { text-decoration: none; color: #64748b; font-weight: 500; font-size: 0.95rem; transition: color 0.2s; }
        .s-nav-link:hover { color: var(--primary-color); }

        .s-hero { position: relative; padding: 5rem 5%; background-color: var(--primary-color); color: white; text-align: center; overflow: hidden; min-height: 400px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .s-hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.3; z-index: 0; }
        .s-hero-content { position: relative; z-index: 1; max-width: 800px; }
        .s-hero-title { font-size: 3rem; font-weight: 800; margin-bottom: 1rem; line-height: 1.1; }
        .s-hero-subtitle { font-size: 1.25rem; opacity: 0.9; margin-bottom: 2rem; font-weight: 300; }
        .s-btn-cta { display: inline-block; background: white; color: var(--primary-color); padding: 1rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
        .s-btn-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }

        /* CATEGORY BAR */
        .s-category-bar-container { background: white; border-bottom: 1px solid #e2e8f0; padding: 1.5rem 0; }
        .s-category-bar { display: flex; overflow-x: auto; gap: 2rem; padding: 0 5%; scrollbar-width: none; -ms-overflow-style: none; justify-content: center; }
        .s-category-bar::-webkit-scrollbar { display: none; }
        .s-cat-item { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; cursor: pointer; text-decoration: none; color: #64748b; transition: transform 0.2s; min-width: 80px; }
        .s-cat-item:hover { transform: translateY(-3px); color: var(--primary-color); }
        .s-cat-item.active { color: var(--primary-color); }
        .s-cat-item.active .s-cat-icon { border-color: var(--primary-color); background: #e2e8f0; }
        .s-cat-icon { width: 60px; height: 60px; background: #f1f5f9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 0.5rem; font-size: 1.5rem; color: var(--primary-color); border: 2px solid transparent; transition: border-color 0.2s; overflow: hidden; }
        .s-cat-item:hover .s-cat-icon { border-color: var(--primary-color); }
        .s-cat-name { font-size: 0.85rem; font-weight: 600; text-align: center; }

        .s-container { max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem; }
        .s-section-header { text-align: center; margin-bottom: 3rem; }
        .s-section-title { font-size: 2rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem; }
        .s-section-desc { color: #64748b; }

        .s-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem; }
        .s-card { background: white; border-radius: 16px; overflow: hidden; border: 1px solid #f1f5f9; transition: all 0.3s ease; display: flex; flex-direction: column; position: relative; cursor: pointer; }
        .s-card:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
        .s-card-img-container { width: 100%; padding-top: 100%; position: relative; background: #f8fafc; }
        .s-card-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
        .s-card-body { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
        .s-card-category { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; font-weight: 600; margin-bottom: 0.5rem; }
        .s-card-title { font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem; line-height: 1.4; }
        .s-card-desc { font-size: 0.9rem; color: #64748b; margin-bottom: 1rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .s-card-price { font-size: 1.25rem; font-weight: 600; color: var(--primary-color); margin-top: auto; margin-bottom: 1rem; }
        .s-btn-buy { width: 100%; padding: 0.8rem; background-color: #25D366; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none; transition: background 0.2s; }
        .s-btn-buy:hover { background-color: #128C7E; }

        .s-footer { background: #1e293b; color: white; padding: 4rem 1.5rem; margin-top: auto; }
        .s-footer-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 3rem; }
        .s-footer-col h4 { font-size: 1.1rem; margin-bottom: 1.5rem; font-weight: 600; }
        .s-footer-col p { color: #94a3b8; line-height: 1.6; font-size: 0.9rem; }
        .s-footer-links { list-style: none; }
        .s-footer-links li { margin-bottom: 0.8rem; }
        .s-footer-links a { color: #cbd5e1; text-decoration: none; transition: color 0.2s; }
        .s-footer-links a:hover { color: white; }
        .s-copyright { text-align: center; border-top: 1px solid #334155; margin-top: 3rem; padding-top: 2rem; color: #64748b; font-size: 0.85rem; }
        
        /* MODAL */
        .s-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1000; justify-content: center; align-items: center; }
        .s-modal-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); }
        .s-modal-content { position: relative; background: white; width: 90%; max-width: 900px; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); animation: modalFadeIn 0.3s ease; }
        @keyframes modalFadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .s-modal-close { position: absolute; top: 1rem; right: 1rem; background: white; border: none; width: 36px; height: 36px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); z-index: 10; transition: transform 0.2s; }
        .s-modal-close:hover { transform: rotate(90deg); }
        .s-modal-body { display: flex; flex-direction: column; overflow-y: auto; }
        .s-modal-img-col { width: 100%; background: #f8fafc; min-height: 300px; position: relative; }
        .s-modal-img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .s-modal-info-col { padding: 2rem; display: flex; flex-direction: column; }
        .s-modal-title { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; line-height: 1.2; }
        .s-modal-price { font-size: 1.5rem; color: var(--primary-color); font-weight: 700; margin-bottom: 1.5rem; }
        .s-modal-desc { color: #64748b; line-height: 1.7; margin-bottom: 2rem; flex: 1; font-size: 1rem; }
        .s-btn-block { width: 100%; justify-content: center; padding: 1rem; font-size: 1.1rem; }
        
        @media (min-width: 768px) {
            .s-modal-body { flex-direction: row; height: auto; }
            .s-modal-img-col { width: 50%; min-height: 500px; }
            .s-modal-info-col { width: 50%; padding: 3rem; }
        }

        @media (max-width: 900px) {
            .s-hero-title { font-size: 2rem; }
            .s-nav-links { display: none; }
            .s-category-bar { justify-content: flex-start; } /* Scroll en movil */
        }
    </style>
</head>
<body>
    ${htmlContent}
</body>
</html>`;

                            const blob = new Blob([fullHTML], { type: 'text/html' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = `tienda-${name.replace(/\s+/g, '-').toLowerCase()}.html`;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                        }

                        // Iniciar
                        init();
                    </script>

</body>

</html>